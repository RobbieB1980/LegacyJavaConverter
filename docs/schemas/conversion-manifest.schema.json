{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://legacyjavaconverter.local/schemas/conversion-manifest-v1.json",
  "title": "LegacyJavaConverter conversion manifest",
  "type": "object",
  "required": ["schemaVersion", "run", "input", "target", "converter", "rules", "validation"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "run": {
      "type": "object",
      "required": ["createdUtc"],
      "properties": { "createdUtc": { "type": "string", "format": "date-time" } }
    },
    "input": {
      "type": "object",
      "required": ["path", "kind", "files"],
      "properties": {
        "path": { "type": "string" },
        "kind": { "enum": ["file", "directory"] },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256", "size"],
            "properties": {
              "path": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
              "size": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "required": ["minecraft", "neoforge"],
      "properties": {
        "minecraft": { "const": "26.2" },
        "neoforge": { "type": "string" }
      }
    },
    "converter": {
      "type": "object",
      "required": ["version"],
      "properties": { "version": { "type": "string" } }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "files", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "files": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "string" }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["intake", "deterministic", "javaParsed", "built", "clientBooted", "worldLoaded", "contentSmokeTested"],
      "additionalProperties": {
        "type": "object",
        "required": ["status", "evidencePath"],
        "properties": {
          "status": { "enum": ["notRun", "passed", "failed", "blocked"] },
          "evidencePath": { "type": "string" }
        }
      }
    }
  }
}
